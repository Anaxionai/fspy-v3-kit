# MockPay settings. Copy this file to .env and change what you need.
# Docker Compose reads .env by itself. With uv:  uv run --env-file .env mockpay

# Where MockPay sends webhooks (your RailSeat API).
# MockPay in Docker:  http://host.docker.internal:8000/payments/webhook
# MockPay with uv:    http://localhost:8000/payments/webhook
MOCKPAY_WEBHOOK_URL=http://host.docker.internal:8000/payments/webhook

# The shared secret for the X-MockPay-Signature header. RailSeat needs the same value.
MOCKPAY_WEBHOOK_SECRET=mockpay_test_secret

# The key RailSeat sends as "Authorization: Bearer mp_test_key".
MOCKPAY_API_KEY=mp_test_key

# Share of webhooks sent twice (0 = never, 1 = always).
MOCKPAY_DUPLICATE_RATE=0.3

# Seconds before the first try of each webhook (20% get 0 to 10 s more).
MOCKPAY_DELAY_SECONDS=2

# Seconds before "Pay (times out)" fails.
MOCKPAY_TIMEOUT_SECONDS=30
