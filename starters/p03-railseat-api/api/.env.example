# RailSeat API settings.
# The code uses these values when a variable is not set, so P3 needs no .env file.
# They are the course kit's public cloud lab defaults, not secrets.
# Never commit a real .env file.
DATABASE_URL=postgresql+asyncpg://railseat:railseat@localhost:5432/railseat
TEST_DATABASE_URL=postgresql+asyncpg://railseat:railseat@localhost:5432/railseat_test
