# TiffinTrack settings. Every program reads them from the environment.
# Each one has the default shown here, so you need a .env file only when a value differs.
# To use one: copy this file to .env, change it, and start a program with
#   uv run --env-file .env fastapi dev api/app/main.py

# Redis from the cloud lab's core profile (API and WebSocket server, from task 8).
REDIS_URL=redis://localhost:6379/0

# MongoDB from the cloud lab's mongo profile, with no password (API, from task 15).
MONGO_URL=mongodb://localhost:27017
MONGO_DB=tiffintrack

# Where the simulator and the WebSocket server find the API.
API_URL=http://localhost:8000

# The arrival estimate's speed in km/h when a rider's own speed is unknown or too low (task 20).
CITY_SPEED_KMH=18
