# An example of the Secret tiffintrack-secrets, for a teammate, with fake values only (task 10).
# kubectl apply -f k8s/ skips this file, because its name does not end in .yaml.
# Create the real Secret with kubectl create secret generic (task 10, step 3), never from a file.
apiVersion: v1
kind: Secret
metadata:
  name: tiffintrack-secrets
type: Opaque
stringData:
  MONGO_PASSWORD: # TODO(task 10): a fake password, such as change-me
  MONGO_URL: # TODO(task 10): the connection string from step 3, with the same fake password
