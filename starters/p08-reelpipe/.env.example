# ReelPipe settings. Copy this file to .env, and never commit .env:
#   cp .env.example .env
# The API reads .env through `uv run --env-file .env ...`, the worker through compose.yaml,
# and the tests through tests/conftest.py. Every value here is a local emulator value, not a secret.

# AWS on Floci (task 8): the kit's fake keys and the course region.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# How many times the worker tries a job before it goes to the dead-letter queue (task 12).
# Use 5 for Pub/Sub runs (task 21).
MAX_ATTEMPTS=3

# Who sends the job (task 18): api (POST /uploads/{video_id}/complete) or event (S3 event and Lambda).
JOB_TRIGGER=api

# Which adapters get_backend() and get_queue() return (task 19).
# STORAGE_BACKEND: s3, azure (task 20) or gcs (task 21). QUEUE_BACKEND: sqs or pubsub (task 21).
STORAGE_BACKEND=s3
QUEUE_BACKEND=sqs

# Azure Blob Storage on Azurite (task 20): Azurite's public development account,
# as in the kit's cloudlab/azure/README.md.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;QueueEndpoint=http://127.0.0.1:10001/devstoreaccount1;TableEndpoint=http://127.0.0.1:10002/devstoreaccount1;

# Google Cloud on fake-gcs-server and the Pub/Sub emulator (task 21).
# The kit's cloudlab/gcp/README.md explains each one.
STORAGE_EMULATOR_HOST=http://localhost:4443
GCS_PUBLIC_URL=http://localhost:4443
PUBSUB_EMULATOR_HOST=localhost:8085
GOOGLE_CLOUD_PROJECT=fspy-local
# Run the kit's cloudlab/gcp/make_signing_key.py and paste the path it prints. Never copy the key here.
GCS_SIGNING_KEY_FILE=
